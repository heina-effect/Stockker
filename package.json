{
  "name": "stockker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:reset": "lsof -ti:3000,3001 | xargs kill -9 || true && rm -rf .next && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate": "npm run lint && npm run typecheck && npm run validate:master",
    "validate:master": "node scripts/validate-master-data.mjs",
    "validate:db-master": "node scripts/validate-db-master.mjs",
    "sync:stock-master": "node scripts/sync-stock-master-from-dart.mjs",
    "sync:sector-master": "node scripts/sync-sector-master-fixes.mjs",
    "test:unit": "vitest run",
    "test:charts": "vitest run --passWithNoTests src/**/*.chart.test.ts src/**/*.candlestick.test.ts src/lib/stocks/chart-utils.test.ts",
    "test:charts:intraday": "vitest run src/**/intraday*.test.ts src/**/aggregateToOHLC*.test.ts",
    "test:charts:daily": "vitest run src/**/daily*.test.ts src/**/movingAverage*.test.ts",
    "test:persistence": "vitest run src/server/research/buy-price-plan.test.ts src/lib/user-storage/local-adapter.test.ts",
    "test:contracts": "vitest run --passWithNoTests src/**/contracts*.test.ts src/**/ohlc-route*.test.ts",
    "test:vectors": "vitest run --passWithNoTests src/**/vector*.test.ts src/**/embedding*.test.ts src/server/ai/home-intelligence-normalizer.test.ts",
    "test:storage": "vitest run src/**/source*.test.ts src/**/news*.test.ts",
    "test:report": "vitest run src/components/report/*.test.tsx src/components/report/*.test.ts src/server/research/entity-guard.test.ts src/server/research/detail-entry-guard.test.ts",
    "test:search": "vitest run src/lib/stocks/search-master.test.ts src/components/home/search-hero-card.test.tsx",
    "test:workflows": "vitest run --passWithNoTests src/components/workflows/*.test.tsx src/**/workflow*.test.ts src/**/snapshots*.test.ts",
    "test:evals": "npx tsx src/server/research/evals/test-evaluator.ts",
    "migrate:supabase": "node scripts/migrate-supabase.mjs",
    "validate:full": "npm run validate && npm run test:charts && npm run test:persistence && npm run test:contracts && npm run test:workflows && npm run test:evals && npm run build",
    "mock:research": "echo 'Mock data is built-in; no separate server needed.'"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@google/genai": "^1.44.0",
    "@supabase/supabase-js": "^2.118.0",
    "@types/ws": "^8.18.2",
    "@upstash/redis": "^1.39.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "openai": "^6.27.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
